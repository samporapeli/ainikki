---
const { warnings } = Astro.props as { warnings: string[] };
---

{warnings.length > 0 && (
  <details class="warnings">
    <summary>{warnings.length} huomiota</summary>
    <ul>
      {warnings.map(w => <li>{w}</li>)}
    </ul>
  </details>
)}

<style>
  .warnings {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .warnings summary {
    font-size: 0.85rem;
    color: var(--fg-subtle);
  }

  .warnings ul {
    margin-top: 0.5rem;
    padding-left: 1.25rem;
    font-size: 0.85rem;
    color: var(--fg-subtle);
  }

  .warnings li {
    margin-bottom: 0.35rem;
  }
</style>
