---
import SourceLink from './SourceLink.astro';

interface DroppedStory {
  title: string;
  url: string;
}

const { warnings = [], droppedStories = [] } = Astro.props as {
  warnings?: string[];
  droppedStories?: DroppedStory[];
};
---

{droppedStories.length > 0 && (
  <section class="dropped">
    <h3>Ei voitu sisällyttää</h3>
    <ul>
      {droppedStories.map(s => (
        <li>
          <SourceLink url={s.url} title={s.title} />
        </li>
      ))}
    </ul>
  </section>
)}

{warnings.length > 0 && (
  <details class="warnings">
    <summary>{warnings.length} {warnings.length === 1 ? 'vika' : 'vikaa'}</summary>
    <ul>
      {warnings.map(w => <li>{w}</li>)}
    </ul>
  </details>
)}

<style>
  .dropped {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .dropped h3 {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--fg-muted);
    margin-bottom: 0.5rem;
  }

  .dropped ul {
    padding-left: 1.25rem;
    font-size: 0.9rem;
    color: var(--fg-subtle);
  }

  .dropped li {
    margin-bottom: 0.35rem;
  }

  .warnings {
    margin-top: 0.75rem;
  }

  .warnings summary {
    font-size: 0.85rem;
    color: var(--fg-subtle);
  }

  .warnings ul {
    margin-top: 0.5rem;
    padding-left: 1.25rem;
    font-size: 0.85rem;
    color: var(--fg-subtle);
  }

  .warnings li {
    margin-bottom: 0.35rem;
  }
</style>
