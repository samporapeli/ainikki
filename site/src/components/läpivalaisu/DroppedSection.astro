---
interface DroppedStory {
  url: string;
  title?: string;
}

const { droppedStories = [] } = Astro.props as {
  droppedStories?: DroppedStory[];
};

function hostname(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
}
---

<h2>Ei voitu sisällyttää</h2>
<div class="story-list">
  {droppedStories.map(story => (
    <article class="story-entry">
      <h3 class="story-title">
        <span class="story-headline">
          <a href={story.url} target="_blank" rel="noopener">
            {story.title ? `${story.title} (${hostname(story.url)}) ↗` : `${hostname(story.url)} ↗`}
          </a>
        </span>
      </h3>
    </article>
  ))}
</div>
