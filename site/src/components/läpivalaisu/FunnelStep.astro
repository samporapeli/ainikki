---
import type { PromptCall, TtsSegment } from '../../lib/pipeline-data';
import { formatDurationMs } from '../../lib/format';

interface Props {
  stepKey?: string;
  stepNumber: number;
  stepName: string;
  isLlm: boolean;
  isTts?: boolean;
  modelName?: string | null;
  description: string;
  stats?: string[];
  dotsCount?: number | null;
  audioUrl?: string | null;
  ttsSegments?: Array<TtsSegment | string>;
  pausesAfter?: Set<number>;
  silenceMs?: number;
  prompts?: PromptCall[];
  promptTokenTotal?: number | null;
}

const {
  stepKey = '',
  stepNumber,
  stepName,
  isLlm,
  isTts = false,
  modelName = null,
  description,
  stats = [],
  dotsCount = null,
  audioUrl = null,
  ttsSegments = [],
  pausesAfter = new Set<number>(),
  silenceMs,
  prompts = [],
  promptTokenTotal = null,
} = Astro.props as Props;

const stepClass = isLlm ? 'llm' : 'code';
const badgeClass = isTts ? 'badge badge-tts' : isLlm ? 'badge badge-llm' : 'badge badge-code';
const badgeText = isTts
  ? modelName ? `Puhemalli · ${modelName}` : 'Puhemalli'
  : isLlm
    ? modelName ? `Kielimalli · ${modelName}` : 'Kielimalli'
    : 'Koodi';
const userPreviewLength = 300;
const ttsScriptText = ttsSegments
  .map(segment => typeof segment === 'string' ? segment : (segment.text ?? ''))
  .join('\n\n');
---

<div class={`step ${stepClass}`}>
  <div class="step-head">
    <span class="step-num">{stepNumber}</span>
    <span class="step-name">{stepName}</span>
    <span class={badgeClass}>{badgeText}</span>
  </div>
  <p class="step-desc">{description}</p>
  {stats.length > 0 && (
    <ul class="step-stats">
      {stats.map(stat => <li>{stat}</li>)}
    </ul>
  )}
  {typeof dotsCount === 'number' && dotsCount > 0 && (
    <div class="dot-matrix" aria-hidden="true">
      {Array.from({ length: dotsCount }, () => <span class="dot"></span>)}
    </div>
  )}
  {audioUrl && (
    <audio controls preload="metadata" src={audioUrl} class="audio-player" aria-label="Kuunteluvalikko" />
  )}
  {isTts && ttsSegments.length > 0 && (
    <details class="tts-script">
      <summary class="prompt-summary tts-summary">
        <span class="prompt-label">Käsikirjoitus ({ttsSegments.length} {ttsSegments.length === 1 ? 'osa' : 'osaa'})</span>
        <button type="button" class="prompt-copy tts-copy" data-text={ttsScriptText}>Kopioi</button>
      </summary>
      {ttsSegments.map((segment, index) => {
        const objectSegment = typeof segment === 'string' ? null : segment;
        const segmentIndex = objectSegment?.index ?? index;
        const text = typeof segment === 'string' ? segment : objectSegment?.text ?? '';
        const hasPause = pausesAfter.has(segmentIndex);
        return <>
          {objectSegment && <p class="tts-segment-meta">[{segmentIndex}]{objectSegment.input_bytes != null ? ` ${objectSegment.input_bytes}B` : ''}</p>}
          <pre class="tts-segment">{text}</pre>
          {hasPause && silenceMs != null && (
            <div class="tauko-block"><hr /><span>Tauko: {silenceMs}ms</span></div>
          )}
        </>;
      })}
    </details>
  )}
  {isLlm && prompts.length > 0 && (
    <details class="prompt-step">
      <summary>
        {prompts.length} {prompts.length === 1 ? 'kielimallikutsu' : 'kielimallikutsua'}{promptTokenTotal != null ? `, ${promptTokenTotal} tokenia` : ''}
      </summary>
      {prompts.map((prompt, index) => {
        const systemPrompt = prompt.system_prompt ?? '';
        const userPrompt = prompt.user_prompt ?? '';
        const response = prompt.raw_response ?? '';
        const attempts = prompt.attempts ?? [];
        const showAttempts = attempts.length > 1 || attempts[0]?.status !== 'success';
        const userIsLong = userPrompt.length > userPreviewLength;
        const userPreview = userIsLong ? `${userPrompt.slice(0, userPreviewLength)}...` : userPrompt;
        const menuId = `prompt-menu-${stepKey}-${index}`;
        return <div class="prompt-call">
          <div class="prompt-call-head">
            <h3>
              Kutsu {prompts.length > 1 ? `${index + 1}/${prompts.length}` : index + 1}
              {typeof prompt.duration_ms === 'number' && ` (${formatDurationMs(prompt.duration_ms)})`}
            </h3>
            <div class="prompt-menu">
              <button
                type="button"
                class="prompt-menu-trigger"
                popovertarget={menuId}
                aria-controls={menuId}
                aria-label="Muut kopiointitavat">⋮</button>
              <div id={menuId} class="prompt-menu-panel" popover="auto">
                <button type="button" class="prompt-copy-option" data-copy-format="all">Kopioi kaikki</button>
                <button type="button" class="prompt-copy-option" data-copy-format="openai">Kopioi syötteet (JSON)</button>
              </div>
            </div>
          </div>
          {prompt.status === 'failed' && (
            <p class="prompt-no-reasoning">Kutsu epäonnistui{prompt.error ? `: ${prompt.error}` : ''}</p>
          )}
          <details class="prompt-block">
            <summary class="prompt-summary">
              <span class="prompt-label">Järjestelmäkehote <span class="prompt-size">{systemPrompt.length} merkkiä</span></span>
              <button type="button" class="prompt-copy" data-prompt-part="system" data-text={systemPrompt}>Kopioi</button>
            </summary>
            <pre class="prompt-text">{systemPrompt}</pre>
          </details>
          <details class="prompt-block">
            <summary class="prompt-summary">
              <span class="prompt-label">Käyttäjäkehote <span class="prompt-size">{userPrompt.length} merkkiä</span></span>
              <button type="button" class="prompt-copy" data-prompt-part="user" data-text={userPrompt}>Kopioi</button>
            </summary>
            <pre class={`prompt-text${userIsLong ? ' prompt-truncated' : ''}`}>{userPreview}</pre>
            {userIsLong && (
              <button
                class="prompt-expand"
                type="button"
                onclick="this.nextElementSibling.style.display='block';this.previousElementSibling.style.display='none';this.style.display='none'">Näytä koko sisältö</button>
            )}
            {userIsLong && <pre class="prompt-text prompt-full" id={`user-full-${stepKey}-${index}`} style="display:none">{userPrompt}</pre>}
          </details>
          {typeof prompt.reasoning === 'string' ? (
            <details class="prompt-block">
              <summary class="prompt-summary">
                <span class="prompt-label">Päättely <span class="prompt-size">{prompt.reasoning.length} merkkiä</span></span>
                <button type="button" class="prompt-copy" data-prompt-part="reasoning" data-text={prompt.reasoning}>Kopioi</button>
              </summary>
              <pre class="prompt-text">{prompt.reasoning}</pre>
            </details>
          ) : prompt.reasoning === null ? (
            <p class="prompt-no-reasoning">
              <span class="prompt-label">Päättely</span>
              <span class="prompt-size">Ei päättelyä</span>
            </p>
          ) : null}
          <details class="prompt-block">
            <summary class="prompt-summary">
              <span class="prompt-label">Vastaus <span class="prompt-size">{response.length} merkkiä</span></span>
              <button type="button" class="prompt-copy" data-prompt-part="response" data-text={response}>Kopioi</button>
            </summary>
            <pre class="prompt-text">{response}</pre>
          </details>
          {showAttempts && attempts.length > 0 && (
            <details class="prompt-block">
              <summary class="prompt-summary">
                <span class="prompt-label">Yritykset <span class="prompt-size">{attempts.length} {attempts.length === 1 ? 'kutsu' : 'kutsua'}</span></span>
              </summary>
              {attempts.map((attempt, attemptIndex) => <div class="prompt-attempt">
                <h3 class="prompt-call-attempt">
                  {attemptIndex + 1}. {attempt.provider ?? 'Tuntematon palvelu'}/{attempt.model ?? 'Tuntematon malli'}
                  <span class="prompt-size">
                    {attempt.status === 'success' ? 'onnistui' : 'epäonnistui'}
                    {typeof attempt.duration_ms === 'number' ? ` · ${formatDurationMs(attempt.duration_ms)}` : ''}
                  </span>
                </h3>
                {attempt.error && <p class="prompt-size">{attempt.error}</p>}
                {attempt.status === 'failed' && typeof attempt.reasoning === 'string' && <pre class="prompt-text">{attempt.reasoning}</pre>}
                {attempt.status === 'failed' && typeof attempt.response === 'string' && <pre class="prompt-text">{attempt.response}</pre>}
              </div>)}
            </details>
          )}
        </div>;
      })}
    </details>
  )}
</div>

<script>
  const copyButtons = document.querySelectorAll('button.prompt-copy');
  const copyOptions = document.querySelectorAll('button.prompt-copy-option');
  const promptMenus = document.querySelectorAll('.prompt-menu-panel[popover]');

  function showCopyResult(button, label) {
    const originalLabel = button.textContent;
    button.textContent = label;
    button.classList.add('copied');
    setTimeout(() => {
      button.textContent = originalLabel;
      button.classList.remove('copied');
    }, 1500);
  }

  async function copyText(text, button) {
    try {
      if (!text || !navigator.clipboard) {
        throw new Error('Clipboard unavailable');
      }
      await navigator.clipboard.writeText(text);
      showCopyResult(button, 'Kopioitu!');
    } catch {
      showCopyResult(button, 'Kopiointi epäonnistui');
    }
  }

  function promptParts(call) {
    const value = part => call.querySelector(`[data-prompt-part="${part}"]`)?.getAttribute('data-text') ?? '';
    return {
      system: value('system'),
      user: value('user'),
      reasoning: value('reasoning'),
      response: value('response'),
    };
  }

  function copyAll(parts) {
    const sections = [
      ['system-prompt', parts.system],
      ['user-prompt', parts.user],
      ['reasoning', parts.reasoning],
      ['response', parts.response],
    ].filter(([, text]) => text !== '');
    return `<llm-call>\n${sections.map(([tag, text]) => `<${tag}>\n${text}\n</${tag}>`).join('\n')}\n</llm-call>`;
  }

  function copyOpenAiMessages(parts) {
    return JSON.stringify({
      messages: [
        ...(parts.system !== '' ? [{ role: 'system', content: parts.system }] : []),
        ...(parts.user !== '' ? [{ role: 'user', content: parts.user }] : []),
      ],
    }, null, 2);
  }

  function positionMenu(menu) {
    const trigger = document.querySelector(`[popovertarget="${menu.id}"]`);
    if (!trigger) return;
    const rect = trigger.getBoundingClientRect();
    const left = Math.max(8, Math.min(
      rect.right - menu.offsetWidth,
      window.innerWidth - menu.offsetWidth - 8,
    ));
    menu.style.top = `${Math.max(8, rect.bottom + 4)}px`;
    menu.style.left = `${left}px`;
  }

  promptMenus.forEach(menu => {
    menu.addEventListener('toggle', () => {
      if (menu.matches(':popover-open')) {
        requestAnimationFrame(() => positionMenu(menu));
      }
    });
  });

  copyButtons.forEach(button => {
    button.addEventListener('click', event => {
      event.preventDefault();
      event.stopPropagation();
      copyText(button.getAttribute('data-text') ?? '', button);
    });
  });

  copyOptions.forEach(button => {
    button.addEventListener('click', event => {
      event.preventDefault();
      event.stopPropagation();
      const call = button.closest('.prompt-call');
      const menu = button.closest('.prompt-menu-panel');
      if (!call) return;
      const parts = promptParts(call);
      const text = button.dataset.copyFormat === 'openai'
        ? copyOpenAiMessages(parts)
        : copyAll(parts);
      copyText(text, button);
      if (menu?.matches(':popover-open')) menu.hidePopover();
    });
  });
</script>
