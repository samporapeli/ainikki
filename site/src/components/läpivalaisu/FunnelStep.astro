---
import type { PromptCall, TtsSegment } from '../../lib/pipeline-data';

interface Props {
  stepKey?: string;
  stepNumber: number;
  stepName: string;
  isLlm: boolean;
  isTts?: boolean;
  modelName?: string | null;
  description: string;
  stats?: string[];
  dotsCount?: number | null;
  audioUrl?: string | null;
  ttsSegments?: Array<TtsSegment | string>;
  pausesAfter?: Set<number>;
  silenceMs?: number;
  prompts?: PromptCall[];
  promptTokenTotal?: number | null;
}

const {
  stepKey = '',
  stepNumber,
  stepName,
  isLlm,
  isTts = false,
  modelName = null,
  description,
  stats = [],
  dotsCount = null,
  audioUrl = null,
  ttsSegments = [],
  pausesAfter = new Set<number>(),
  silenceMs,
  prompts = [],
  promptTokenTotal = null,
} = Astro.props as Props;

const stepClass = isLlm ? 'llm' : 'code';
const badgeClass = isTts ? 'badge badge-tts' : isLlm ? 'badge badge-llm' : 'badge badge-code';
const badgeText = isTts
  ? modelName ? `Puhemalli · ${modelName}` : 'Puhemalli'
  : isLlm
    ? modelName ? `Kielimalli · ${modelName}` : 'Kielimalli'
    : 'Koodi';
const userPreviewLength = 300;
---

<div class={`step ${stepClass}`}>
  <div class="step-head">
    <span class="step-num">{stepNumber}</span>
    <span class="step-name">{stepName}</span>
    <span class={badgeClass}>{badgeText}</span>
  </div>
  <p class="step-desc">{description}</p>
  {stats.length > 0 && (
    <ul class="step-stats">
      {stats.map(stat => <li>{stat}</li>)}
    </ul>
  )}
  {typeof dotsCount === 'number' && dotsCount > 0 && (
    <div class="dot-matrix" aria-hidden="true">
      {Array.from({ length: dotsCount }, () => <span class="dot"></span>)}
    </div>
  )}
  {audioUrl && (
    <audio controls preload="metadata" src={audioUrl} class="audio-player" aria-label="Kuunteluvalikko" />
  )}
  {isTts && ttsSegments.length > 0 && (
    <details class="tts-script">
      <summary>Käsikirjoitus ({ttsSegments.length} {ttsSegments.length === 1 ? 'osa' : 'osaa'})</summary>
      {ttsSegments.map((segment, index) => {
        const objectSegment = typeof segment === 'string' ? null : segment;
        const segmentIndex = objectSegment?.index ?? index;
        const text = typeof segment === 'string' ? segment : objectSegment?.text ?? '';
        const hasPause = pausesAfter.has(segmentIndex);
        return <>
          {objectSegment && <p class="tts-segment-meta">[{segmentIndex}]{objectSegment.input_bytes != null ? ` ${objectSegment.input_bytes}B` : ''}</p>}
          <pre class="tts-segment">{text}</pre>
          {hasPause && silenceMs != null && (
            <div class="tauko-block"><hr /><span>Tauko: {silenceMs}ms</span></div>
          )}
        </>;
      })}
    </details>
  )}
  {isLlm && prompts.length > 0 && (
    <details class="prompt-step">
      <summary>
        Kielimallin syöte ja vastaus — {prompts.length} {prompts.length === 1 ? 'kutsu' : 'kutsua'}{promptTokenTotal != null ? `, ${promptTokenTotal} tokenia` : ''}
      </summary>
      {prompts.map((prompt, index) => {
        const systemPrompt = prompt.system_prompt ?? '';
        const userPrompt = prompt.user_prompt ?? '';
        const response = prompt.raw_response ?? '';
        const userIsLong = userPrompt.length > userPreviewLength;
        const userPreview = userIsLong ? `${userPrompt.slice(0, userPreviewLength)}...` : userPrompt;
        return <div class="prompt-call">
          <h3>Kutsu {prompts.length > 1 ? `${index + 1}/${prompts.length}` : index + 1}</h3>
          <details class="prompt-block">
            <summary class="prompt-summary">System prompt <span class="prompt-size">{systemPrompt.length} merkkiä</span></summary>
            <pre class="prompt-text">{systemPrompt}</pre>
          </details>
          <details class="prompt-block">
            <summary class="prompt-summary">User prompt <span class="prompt-size">{userPrompt.length} merkkiä</span></summary>
            <pre class={`prompt-text${userIsLong ? ' prompt-truncated' : ''}`} id={`user-${stepKey}-${index}`}>{userPreview}</pre>
            {userIsLong && (
              <button
                class="prompt-expand"
                type="button"
                onclick="this.nextElementSibling.style.display='block';this.previousElementSibling.style.display='none';this.style.display='none'">Näytä koko sisältö</button>
            )}
            {userIsLong && <pre class="prompt-text prompt-full" id={`user-full-${stepKey}-${index}`} style="display:none">{userPrompt}</pre>}
          </details>
          <details class="prompt-block">
            <summary class="prompt-summary">Vastaus <span class="prompt-size">{response.length} merkkiä</span></summary>
            <pre class="prompt-text">{response}</pre>
          </details>
        </div>;
      })}
    </details>
  )}
</div>
