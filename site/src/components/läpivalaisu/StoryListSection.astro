---
import StoryCard from '../StoryCard.astro';
import type { BriefingItem } from '../../lib/pipeline-data';

interface ScoredCandidate {
  rank: number;
  url: string;
  title?: string;
  selection_reason?: string;
}

interface Props {
  items: BriefingItem[];
  scoredCandidates?: ScoredCandidate[];
  cutoffRank?: number;
}

const { items, scoredCandidates = [], cutoffRank } = Astro.props as Props;
const sortedItems = items.slice().sort((a, b) => a.rank - b.rank);
const includedUrls = new Set(sortedItems.flatMap(item => item.sources.map(source => String(source.url))));
const notIncluded = typeof cutoffRank === 'number'
  ? scoredCandidates.filter(candidate => candidate.rank > cutoffRank && !includedUrls.has(String(candidate.url))).sort((a, b) => a.rank - b.rank)
  : [];

function hostname(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
}

---

<h2>Koosteen artikkelit</h2>
<div class="story-list">
  {sortedItems.map(item => (
    <StoryCard item={item} showRank showAllSources showSelectionReason />
  ))}
  {notIncluded.length > 0 && (
    <>
      <div class="story-divider"><span>Pisteytyksessä valitut, mutta koosteen ulkopuolelle jääneet</span></div>
      <div class="scored-rest">
        {notIncluded.map(candidate => (
          <article class="scored-entry">
            <h3 class="story-title">
              <span class="story-num">#{candidate.rank}</span>
              <span class="story-headline"><a href={candidate.url} target="_blank" rel="noopener">{candidate.title ? `${candidate.title} (${hostname(candidate.url)}) ↗` : `${hostname(candidate.url)} ↗`}</a></span>
            </h3>
            {candidate.selection_reason && <div class="story-reason"><span class="reason-label">Valinnan peruste:</span> {candidate.selection_reason}</div>}
          </article>
        ))}
      </div>
    </>
  )}
</div>
