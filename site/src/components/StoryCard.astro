---
interface Source {
  url: string;
  title: string;
  source_badge?: string;
  source_type?: string;
}

interface NewsItem {
  headline: string;
  summary: string;
  sources: Source[];
  rank: number;
  reason?: string;
  selection_reason?: string;
}

const { item, showRank = false, showAllSources = false, showSelectionReason = false } = Astro.props as {
  item: NewsItem;
  showRank?: boolean;
  showAllSources?: boolean;
  showSelectionReason?: boolean;
};

const sources = showAllSources ? item.sources : item.sources.slice(0, 1);

function hostname(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
}
---

<article class="story">
  <h2>{showRank && <span class="rank">#{item.rank}</span>}{item.headline}</h2>
  <p class="summary">{item.summary}</p>
  {item.reason && (
    <p class="reason"><span class="reason-label">Perustelu:</span> <em>{item.reason}</em></p>
  )}
  {showSelectionReason && item.selection_reason && (
    <p class="reason"><span class="reason-label">Valinnan peruste:</span> <em>{item.selection_reason}</em></p>
  )}
  {sources.map(source => (
    <p class="source">
      <a href={source.url} target="_blank" rel="noopener">{hostname(source.url)} ↗</a>
    </p>
  ))}
</article>

<style>
  .story {
    padding: 1.5rem 0;
  }

  .story + .story {
    border-top: 1px solid var(--border);
  }

  h2 {
    margin-bottom: 0.5rem;
  }

  .rank {
    color: var(--fg-subtle);
    font-weight: 500;
    margin-right: 0.35rem;
  }

  .summary {
    color: var(--fg-muted);
    font-size: 0.95rem;
    line-height: 1.65;
    margin-bottom: 0.5rem;
  }

  .reason {
    color: var(--fg-subtle);
    font-size: 0.85rem;
    font-style: italic;
    line-height: 1.5;
    padding: 0.4rem 0 0.4rem 0.75rem;
    border-left: 2px solid var(--border);
    margin-bottom: 0.75rem;
  }

  .reason-label {
    font-weight: 600;
  }

  .source {
    font-size: 0.85rem;
    color: var(--fg-subtle);
  }
</style>
