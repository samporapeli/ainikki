---
interface Source {
  url: string;
  title: string;
  source_type: string;
}

interface NewsItem {
  headline: string;
  summary: string;
  sources: Source[];
  rank: number;
}

const { item } = Astro.props as { item: NewsItem };

const primarySource = item.sources[0];
const sourceHost = primarySource ? new URL(primarySource.url).hostname : null;
---

<article class="story">
  <h2>{item.headline}</h2>
  <p class="summary">{item.summary}</p>
  {primarySource && (
    <p class="source">
      <a href={primarySource.url} target="_blank" rel="noopener">Lue ({sourceHost}) ↗</a>
    </p>
  )}
</article>

<style>
  .story {
    padding: 1.5rem 0;
  }

  .story + .story {
    border-top: 1px solid var(--border);
  }

  h2 {
    margin-bottom: 0.5rem;
  }

  .summary {
    color: var(--fg-muted);
    font-size: 0.95rem;
    line-height: 1.65;
    margin-bottom: 0.5rem;
  }

  .source {
    font-size: 0.85rem;
    color: var(--fg-subtle);
  }
</style>
