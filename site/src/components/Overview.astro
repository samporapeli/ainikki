---
const { text } = Astro.props as { text: string };
---

<section class="overview">
  <p class="overview-label">Yleiskatsaus</p>
  <p class="summary">{text}</p>
</section>

<style>
  .overview {
    margin-bottom: 2rem;
    padding: 1.25rem 1.5rem;
    background: #f6f6f6;
    border-radius: 0.5rem;
  }

  .overview-label {
    color: var(--fg-subtle);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.3;
    margin-bottom: 0.55rem;
    text-transform: uppercase;
  }

  .summary {
    margin: 0;
    font-size: 1.05rem;
    color: var(--fg-muted);
    line-height: 1.7;
  }

  @media (prefers-color-scheme: dark) {
    .overview {
      background: #181818;
    }
  }
</style>
