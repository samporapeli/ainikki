---
import { readFileSync, readdirSync } from 'node:fs';
import path from 'node:path';
import { load } from 'js-yaml';
import Layout from '../layouts/Layout.astro';
import { TOPIC_META } from '../lib/topics';

const sourcesPath = path.resolve('../config/sources.yaml');
const sourcesData = load(readFileSync(sourcesPath, 'utf-8'));
const sourcesMap = Object.fromEntries((sourcesData.sources || []).map((s: any) => [s.key, s]));

const topicsDir = path.resolve('../config/topics');

const topics = readdirSync(topicsDir)
  .filter(f => f.endsWith('.yaml') && f !== 'sources.yaml')
  .map(file => {
    const config = load(readFileSync(path.join(topicsDir, file), 'utf-8'));
    const topic = file.replace('.yaml', '');
    const sourceKeys = config.sources || [];
    const sources = sourceKeys
      .map((key: string) => sourcesMap[key])
      .filter(Boolean)
      .map((s: any) => ({
        type: s.type,
        name: s.pretty_name,
        siteUrl: s.site_url,
        note: s.type === 'hn' ? 'Algolian rajapinnan kautta' : 'RSS-syötteen kautta',
      }));
    return { topic, sources };
  });
const topicSlug = (name: string) => name.replace(/\s+/g, '').toLowerCase();

// Build a unified source list across all topics, collecting which
// topics use each source. Sources are ordered by frequency (most-used first)
// then alphabetically, so "common across topics" sources appear first.
const sourceUsage = new Map<string, { label: string; siteUrl: string; topics: string[] }>();
for (const t of topics) {
  for (const s of t.sources) {
    const key = s.name;
    if (!sourceUsage.has(key)) {
      sourceUsage.set(key, { label: key, siteUrl: s.siteUrl, topics: [] });
    }
    sourceUsage.get(key)!.topics.push(t.topic);
  }
}
const allSources = [...sourceUsage.entries()]
  .sort((a, b) => (b[1].topics.length - a[1].topics.length) || a[0].localeCompare(b[0]))
  .map(([, v]) => v);

const topicCount = topics.length;

 const steps = [
   {
     name: 'Keruu',
     llm: false,
     description: 'Hakee uutisia määritellyistä lähteistä (Hacker News, uutissivustojen RSS-syötteet). Suodattaa pois jutut, jotka ovat saaneet vähän pisteitä.',
   },
   {
     name: 'Duplikaattien poisto',
     llm: false,
     description: 'Normalisoi URL-osoitteet ja yhdistää samat linkit toisiinsa.',
   },
   {
     name: 'Aiheen suodatus',
     llm: true,
     description: 'Kielimalli tarkistaa jokaisen ehdokkaan ja pudottaa pois ne, jotka eivät liity käsiteltävään aiheeseen.',
   },
   {
     name: 'Ryhmittely',
     llm: true,
     description: 'Kielimalli tunnistaa samasta asiasta kertovat jutut eri lähteistä ja ryhmittelee ne yhteen.',
   },
   {
     name: 'Pisteytys',
     llm: true,
     description: 'Kielimalli valitsee ja järjestää 3–10 uutista arviointikriteerien perusteella. Uutiset, joita on käsitelty viikon sisällä julkaistuissa koosteissa, jätetään pois.',
   },
   {
     name: 'Rikastaminen',
     llm: false,
     description: 'Lataa pisteytyksessä valittujen artikkeleiden sivut ja erottaa niistä varsinaisen artikkelitekstin sivun rakenteesta (valikot, mainokset, evästeilmoitukset).',
   },
   {
     name: 'Kirjoitus',
     llm: true,
     description: 'Kielimalli kirjoittaa jokaisesta uutisesta otsikon ja suomenkielisen tiivistelmän. Jos rikastaminen tai kirjoitus pudottaa liikaa juttuja, koostetta täydennetään pisteytyksen seuraavaksi parhailla ehdokkailla.',
   },
   {
     name: 'Yleiskuva',
     llm: true,
     description: 'Kielimalli kirjoittaa lyhyen yhteenvedon päivän koosteesta.',
   },
   {
     name: 'Validointi',
     llm: false,
     description: 'Kokoaa tulokset yhteen ja tarkistaa, että kooste on täydellinen ja julkaisukelpoinen.',
   },
 ];
---

<Layout title="Tietoja — Ainikki" description="Miten Ainikki toimii: uutisten keruu, valinta ja koosteen tuottaminen.">
  <nav class="back">
    <a href="../">← Ainikki</a>
  </nav>

  <header>
    <h1>Miten Ainikki toimii</h1>
  </header>

  <section class="intro">
    <p>
      Ainikki kerää uutisia määritellyistä aiheista, valitsee niistä
      tärkeimmät ja kirjoittaa jokaisesta suomenkielisen tiivistelmän.
      Prosessi koostuu kymmenestä vaiheesta, joista osa käyttää kielimalleja
      (tekoälyä) ja osa on determinististä logiikkaa eli perinteistä koodia.
    </p>
  </section>

  <section class="pipeline">
    <h2>Prosessi</h2>
    <div class="flow">
      {steps.map((step, i) => (
        <div class={`step ${step.llm ? 'llm' : 'code'}`}>
          <div class="step-head">
            <span class="step-num">{i + 1}</span>
            <span class="step-name">{step.name}</span>
            <span class={`badge ${step.llm ? 'badge-llm' : 'badge-code'}`}>
              {step.llm ? 'Kielimalli' : 'Koodi'}
            </span>
          </div>
          <p class="step-desc">{step.description}</p>
        </div>
      ))}
    </div>
  </section>

  <hr />

  <section class="details">
    <h2>Mikä on kielimalli ja mikä koodia?</h2>
    <p>
      Viisi vaihetta (ryhmittely, aiheen suodatus, pisteytys, kirjoitus, yleiskuva) käyttää suuria
      kielimalleja (LLM). Ne tekevät päätöksiä, jotka vaativat ymmärrystä
      kielestä ja sisällöstä — esimerkiksi saman uutisen tunnistamista eri
      lähteistä tai uutisen merkityksen arvioimista.
    </p>
    <p>
      Muut vaiheet ovat ohjelmallista logiikkaa: tiedon haku,
      URL-normalisointi, tekstin poiminta ja validointi. Nämä ovat
      täsmällisiä eivätkä tee arviointia.
    </p>
  </section>

  <section class="details">
    <h2>Aiheet, lähteet ja julkaisu</h2>
    <div class="matrix" style={`grid-template-columns: auto repeat(${topicCount}, 1fr);`}>
      <div class="matrix-row matrix-header">
        <div class="matrix-label"></div>
        {topics.map(t => (
          <div class="matrix-topic">{TOPIC_META[t.topic]?.name ?? t.topic}</div>
        ))}
      </div>

      <div class="matrix-row matrix-row-rytmi">
        <div class="matrix-label">Julkaisurytmi</div>
        {topics.map(t => (
          <div class="matrix-cell">{TOPIC_META[t.topic]?.period ?? t.topic}</div>
        ))}
      </div>

      {allSources.map(s => (
        <div class="matrix-row">
          <div class="matrix-label"><a href={s.siteUrl} target="_blank" rel="noopener noreferrer">{s.label}</a></div>
          {topics.map(t => (
            <div class="matrix-cell">{s.topics.includes(t.topic) ? '✓' : ''}</div>
          ))}
        </div>
      ))}

      <div class="matrix-row matrix-row-tg">
        <div class="matrix-label">Telegram</div>
        {topics.map(t => {
          const meta = TOPIC_META[t.topic];
          return (
            <div class="matrix-cell">{meta?.telegramUrl ? <a href={meta.telegramUrl} target="_blank" rel="noopener noreferrer">{meta.telegram}</a> : ''}</div>
          );
        })}
      </div>
    </div>
  </section>

  <section class="details">
    <h2>Asetukset ja ääni</h2>
    <p>
      Koosteen tyyli ja sisältö määräytyvät asetustiedostojen perusteella,
      ei koodista:
    </p>
    <ul>
      <li><strong>Pisteytyskriteeristö</strong> — arviointikriteerit ja painoarvot</li>
      <li>
        <strong>Persoona</strong> — kohdeyleisö ja ääni. Ainikki kirjoittaa
        kokeneelle kehittäjälle, joka seuraa alaa mutta ei ehdi lukea kaikkea
        itse, eikä siksi selitä peruskäsitteitä. Sävy on suora eikä hehkuta
        uutisia, eikä tekstissä käytetä klikkiotsikoita tai emojeja.
      </li>
      <li>
        <strong>Sääntökehys</strong> — pätee aina, riippumatta persoonasta.
        Tiivistelmät perustuvat vain annettuun lähdemateriaaliin, eivätkä ne
        spekuloi seurauksilla, joita lähde ei mainitse. Jos lähteet ovat
        keskenään ristiriidassa, ristiriita mainitaan sen sijaan, että
        valittaisiin puoli. Kehys sisältää myös suomen kielen sääntöjä
        (esim. yhdyssanat, pilkutus, anglismien välttäminen).
      </li>
      <li><strong>Kultaiset esimerkit</strong> — käsin kuratoitu, kiinteä esimerkkisetti hyvistä tiivistelmistä; ei kasva automaattisesti aiemmista julkaisuista, jotta tyyli ei ajaudu ajan myötä</li>
    </ul>
    <p>
      Kaikki tiedostot ovat versioituja: kun ääntä muutetaan merkittävästi,
      vanhaa tiedostoa ei muokata vaan tehdään uusi versio. Näin vanhat
      julkaisut pysyvät jäljitettävissä siihen persoonaan, jolla ne on
      kirjoitettu.
    </p>
  </section>

  <section class="details">
    <h2>Mallit ja kustannukset</h2>
    <p>
      Jokainen vaihe voi käyttää eri mallia. Halvat mallit riittävät
      luokitteluun ja pisteytykseen, kun taas tiivistelmien kirjoittamiseen
      valitaan laadukkaampi malli. Näin kustannukset ja laatu pysyvät
      tasapainossa.
    </p>
    <p>
      Tällä hetkellä kaikki mallit toimivat{' '}
      <a href="https://openrouter.ai/" target="_blank" rel="noopener noreferrer">OpenRouterin</a> kautta, joka tarjoaa
      lukuisia vaihtoehtoja. Mallin voi vaihtaa vaihekohtaisesti yhdellä config-rivillä.
    </p>
    <p>
      Malliriippumattomuus on tietoinen valinta: kun uusia, sopivampia
      malleja julkaistaan tai vanhoja poistuu tarjonnasta, Ainikki voidaan
      siirtää käyttämään niitä ilman, että koko toteutusta joudutaan
      rakentamaan uudelleen.
    </p>
    <p>
      Päivittäisen koosteen luonti maksaa tällä hetkellä noin 0,05–0,15 euroa.
      Toisin kuin monet tekoälypalvelut, Ainikin tuotos on jaettua: sama kooste
      näytetään kaikille käyttäjille. Mitä enemmän käyttäjiä, sitä pienempi
      generointikustannus käyttäjää kohti.
    </p>
  </section>

  <section class="details">
    <h2>Rajoitukset</h2>
    <p>
      Ainikki käyttää suuria kielimalleja (eli tekoälyä) ja voi tehdä virheitä. Ihminen ei tarkista
      sisältöä.
    </p>
    <p>
      Jos artikkelin sisältöä ei saada ladattua (esim. robots.txt estää
      haun, sivu on tyhjä tai vaatii JavaScriptin), uutinen jätetään
      koosteesta pois kokonaan. Jos artikkelia ei ole käsitelty
      riittävän monessa lähteessä, tiettyjä näkökulmia saattaa puuttua.
    </p>
    <p>
      Pisteytys, aihevalinta ja tiivistäminen ovat luonnoltaan subjektiivisia
      tehtäviä, joihin <a href="https://fi.wikipedia.org/wiki/Kognitiivinen_vinouma" target="_blank" rel="noopener noreferrer">vinoumat</a>{' '}
      vaikuttavat — oli asialla sitten ihminen tai kone. Ainikin tapauksessa kielimalli
      voi hiljaisesti suosia tiettyjä lähteitä tai näkökulmia.
    </p>
  </section>

  <section class="details">
    <h2>Tietosuoja</h2>
    <p>
      Sivustolla on käytössä itse ylläpidetty <a href="https://plausible.io/" target="_blank" rel="noopener noreferrer">Plausible Analytics</a>,
      eikä muuta seurantaa ole. Käyttäjätunnuksia tai kirjautumista ei ole,
      eikä tietoja yhdistetä yksittäisiin käyttäjiin.
    </p>
    <p>
      Telegram on Ainikista erillinen palvelu, jolla on omat tietosuojakäytännöt. Ainikkia voi hyvin käyttää täysin ilman Telegramia.
    </p>
  </section>

  <section class="details">
    <h2>Avoin lähdekoodi</h2>
    <p>
      Ainikin koodi on avointa ja MIT-lisensoitu:{' '}
      <a href="https://github.com/samporapeli/ainikki" target="_blank" rel="noopener noreferrer">github.com/samporapeli/ainikki</a>.
    </p>
  </section>

  <section class="details">
    <h2>Palaute</h2>
    <p>
      Sisältöä ei käsin hienosäädetä tai korjata julkaisun jälkeen: teksti
      julkaistaan sellaisenaan, sellaisena kuin prosessi sen tuottaa. Jos
      jokin toistuvasti mättää, se korjataan mieluummin prosessista kuin
      yksittäisestä julkaisusta.
    </p>
    <p>
      Palautetta ja virheilmoituksia voi lähettää{' '}
      <a href="https://hachyderm.io/@sampo" target="_blank" rel="noopener noreferrer">Mastodonin</a> tai{' '}
      <a href="https://www.linkedin.com/in/srapeli/" target="_blank" rel="noopener noreferrer">LinkedInin</a> kautta.
    </p>
  </section>

  <section class="details" id="tekija">
    <h2>Tekijä</h2>
    <p>
      Ainikin on tehnyt <a href="https://sampo.website/">Sampo Rapeli</a>, joka
      on käyttänyt kielimalleja ja agenttista koodausta päivittäin niin töissä kuin
      vapaalla jo pidemmän aikaa. Ainikki on kokeilu siitä, miten kielimalli
      toimii itsenäisenä osana automaattista prosessia – ei reagoimassa
      käyttäjän viestiin, vaan ajastettuna ja ilman kenenkään antamaa
      kehotetta. Osa vaiheista käyttää mallia myös rakenteisen datan (esim.
      pisteytyksen JSON-ulostulo) tuottamiseen, ei vain ihmiselle luettavan
      tekstin kirjoittamiseen.
    </p>
    <p>
      Taustalla on myös oma tarve: tekoälyala muuttuu nopeasti, ja
      päivittäinen, lyhyt kooste on tapa pysyä kärryillä ilman, että pitää itse
      seurata uutisia jatkuvasti. Vastaavia koosteita on muitakin (esimerkiksi
      englanninkieliset <a href="https://hackernewsletter.com/" target="_blank" rel="noopener noreferrer">Hacker
      Newsletter</a> ja <a href="https://tldr.tech/" target="_blank" rel="noopener noreferrer">TLDR newsletter</a>),
      joten mullistavasta ideasta ei ole kyse. Toisin kuin monet muut
      koostepalvelut, Ainikki on suomenkielinen ja käyttää ylpeästi kielimalleja
      uutisten valinnassa ja tiivistämisessä.
    </p>
    <p>
      Lisää tekijästä: <a href="https://sampo.website/">etusivu</a> ·{' '}
      <a href="https://sampo.website/blog/fi/">blogi</a> ·{' '}
      <a href="https://www.linkedin.com/in/srapeli/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </p>
  </section>

</Layout>

<style>
  .back {
    margin-bottom: 2rem;
    font-size: 0.9rem;
  }

  header {
    margin-bottom: 2rem;
  }

  .intro {
    color: var(--fg-muted);
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .pipeline h2 {
    margin-bottom: 1.25rem;
  }

  .flow {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .step {
    border-left: 3px solid var(--border);
    padding: 0.75rem 0 0.75rem 1.25rem;
    position: relative;
  }

  .step:last-child {
    border-left-color: transparent;
  }

  .step.llm {
    border-left-color: var(--link);
  }

  .step-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--border);
    color: var(--fg-muted);
    font-size: 0.75rem;
    font-weight: 600;
    flex-shrink: 0;
  }

  .step.llm .step-num {
    background: var(--link);
    color: var(--bg);
  }

  .step-name {
    font-weight: 600;
  }

  .badge {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
  }

  .badge-llm {
    background: var(--link);
    color: var(--bg);
  }

  .badge-code {
    background: var(--border);
    color: var(--fg-muted);
  }

  .step-desc {
    color: var(--fg-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    padding-left: 2rem;
  }

  .details {
    margin-bottom: 2rem;
    color: var(--fg-muted);
    line-height: 1.7;
  }

  .details h2 {
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  .details ul {
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0.5rem 0;
  }

  .details li {
    margin-bottom: 0.25rem;
  }

  .matrix {
    display: grid;
    grid-template-columns: 1fr; /* overridden by inline style */
    gap: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    max-width: 40rem;
  }

  .matrix-row {
    display: contents;
  }

  .matrix-label {
    padding: 0.35rem 0.75rem 0.35rem 0;
    border-bottom: 1px solid var(--border);
    font-weight: 600;
    color: var(--fg);
    min-width: 8rem;
  }

  .matrix-label a {
    color: var(--fg);
  }

  .matrix-label a:hover {
    color: var(--link);
  }

  .matrix-cell {
    padding: 0.35rem 0.5rem;
    border-bottom: 1px solid var(--border);
    text-align: center;
    color: var(--fg-muted);
  }

  .matrix-cell a {
    font-size: 0.8rem;
  }

  .matrix-topic {
    padding: 0.35rem 0.5rem;
    font-weight: 600;
    text-align: center;
    font-size: 0.85rem;
    color: var(--fg);
    border-bottom: 2px solid var(--fg);
  }

  .matrix-row-rytmi .matrix-cell,
  .matrix-row-tg .matrix-cell {
    font-style: italic;
  }

  .matrix-row-tg .matrix-label,
  .matrix-row-tg .matrix-cell {
    border-bottom: none;
  }
</style>
