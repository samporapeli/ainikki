---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';

const dataDir = path.resolve('../data/output');

let topics: string[] = [];

if (fs.existsSync(dataDir)) {
  const files = fs.readdirSync(dataDir).filter(f => f.endsWith('.json'));
  const topicSet = new Set<string>();
  for (const file of files) {
    const data = JSON.parse(fs.readFileSync(path.join(dataDir, file), 'utf-8'));
    topicSet.add(data.topic);
  }
  topics = [...topicSet].sort();
}
---

<Layout title="Ainikki">
  <header>
    <h1>Ainikki</h1>
    <p class="tagline">Tekoäly-uutisten automaattinen suomenkielinen kooste</p>
  </header>

  <section class="about">
    <p>
      Ainikki kerää päivittäin uutisia Hacker Newsista, valitsee ne uutisarvon
      mukaan ja kirjoittaa jokaisesta lyhyen suomenkielisen tiivistelmän.
      Tulokset julkaistaan staattisena verkkosivustona.
    </p>
  </section>

  {topics.length === 0 ? (
    <p class="empty">Ei koosteita vielä.</p>
  ) : (
    <nav class="topics">
      {topics.map(t => (
        <a href={`${t}/`} class="topic-link">
          {t.toUpperCase()}
        </a>
      ))}
    </nav>
  )}

  <p class="footer">
    Avoin lähdekoodi · <a href="https://github.com/samporapeli/ainikki">GitHub</a>
  </p>
</Layout>

<style>
  header {
    margin-bottom: 2.5rem;
  }

  .tagline {
    color: var(--fg-muted);
    font-size: 1.05rem;
    margin-top: 0.35rem;
  }

  .about {
    margin-bottom: 2.5rem;
    color: var(--fg-muted);
    line-height: 1.7;
  }

  .empty {
    color: var(--fg-subtle);
  }

  .topics {
    display: flex;
    flex-direction: column;
  }

  .topic-link {
    display: block;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .topic-link:first-child {
    padding-top: 0;
  }

  .topic-link:hover {
    text-decoration: none;
  }

  .footer {
    margin-top: 3rem;
    font-size: 0.85rem;
    color: var(--fg-subtle);
  }
</style>
