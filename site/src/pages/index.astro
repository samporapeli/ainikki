---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';

const dataDir = path.resolve('../data/output');

let topics: string[] = [];

if (fs.existsSync(dataDir)) {
  const files = fs.readdirSync(dataDir).filter(f => f.endsWith('.json'));
  const topicSet = new Set<string>();
  for (const file of files) {
    const data = JSON.parse(fs.readFileSync(path.join(dataDir, file), 'utf-8'));
    topicSet.add(data.topic);
  }
  topics = [...topicSet].sort();
}
---

<Layout title="Ainikki">
  <header>
    <h1>Ainikki</h1>
    <p class="tagline">Uutiskoosteet tekoälyavustuksella</p>
  </header>

  <section class="about">
    <p>
      Ainikki seuraa uutisia ja kokoaa tärkeimmät suomenkieliseen
      päiväkoosteeseen. Tällä hetkellä Ainikki keskittyy tekoälyuutisiin.
    </p>
    <p class="disclaimer">
      Ainikki on tekoälypohjainen ja voi tehdä virheitä.
      <a href={`${import.meta.env.BASE_URL}/tietoja/`}>Lue lisää siitä, miten Ainikki toimii.</a>
    </p>
  </section>

  {topics.length === 0 ? (
    <p class="empty">Ei koosteita vielä.</p>
  ) : (
    <section class="topic-list">
      <h2>Aiheet</h2>
      <nav class="topics">
        {topics.map(t => (
          <a href={`${import.meta.env.BASE_URL}/${t}/`} class="topic-link">
            {t.toUpperCase()}
          </a>
        ))}
      </nav>
    </section>
  )}

  <p class="footer">
    Avoin lähdekoodi · <a href="https://github.com/samporapeli/ainikki">GitHub</a>
  </p>
</Layout>

<style>
  header {
    margin-bottom: 2.5rem;
  }

  .tagline {
    color: var(--fg-muted);
    font-size: 1.05rem;
    margin-top: 0.35rem;
  }

  .about {
    margin-bottom: 2.5rem;
    color: var(--fg-muted);
    line-height: 1.7;
  }

  .disclaimer {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--fg-subtle);
  }

  .topic-list h2 {
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-muted);
    margin-bottom: 0.75rem;
  }

  .empty {
    color: var(--fg-subtle);
  }

  .topics {
    display: flex;
    flex-direction: column;
  }

  .topic-link {
    display: block;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .topic-link:first-child {
    padding-top: 0;
  }

  .topic-link:hover {
    text-decoration: none;
  }

  .footer {
    margin-top: 3rem;
    font-size: 0.85rem;
    color: var(--fg-subtle);
  }
</style>
