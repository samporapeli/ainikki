---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import { TOPIC_META } from '../lib/topics';

const dataDir = path.resolve('../data/output');

let topics: string[] = [];

if (fs.existsSync(dataDir)) {
  const files = fs.readdirSync(dataDir).filter(f => f.endsWith('.json'));
  const topicSet = new Set<string>();
  for (const file of files) {
    const data = JSON.parse(fs.readFileSync(path.join(dataDir, file), 'utf-8'));
    topicSet.add(data.topic);
  }
  topics = [...topicSet].sort();
}
---

<Layout title="Ainikki">
  <header>
    <h1>Ainikki</h1>
    <p class="tagline">Uutiskoosteet tekoälyavustuksella</p>
  </header>

  <section class="about">
    <p>
      Ainikki kerää uutisia määritellyistä aiheista ja kokoaa tärkeimmät
      suomenkielisiin koosteisiin. Ainikki on kielimallipohjainen ja voi tehdä
      virheitä.{' '}
      <a href={`${import.meta.env.BASE_URL}/tietoja/`}>Lue lisää siitä, miten Ainikki toimii.</a>
    </p>
  </section>

  {topics.length === 0 ? (
    <p class="empty">Ei koosteita vielä.</p>
  ) : (
    <section class="topic-list">
      <h2>Aiheet</h2>
      <nav class="topics">
        {topics.map(t => {
          const info = TOPIC_META[t] ?? { name: t.toUpperCase(), period: '', telegram: '', telegramUrl: '' };
          return (
            <a href={`${import.meta.env.BASE_URL}/${t}/`} class="topic-link">
              <div class="link-content">
                <span class="topic-name">{info.name}</span>
                <span class="topic-period">{info.period}</span>
              </div>
              <span class="chevron">›</span>
            </a>
          );
        })}
      </nav>
    </section>
  )}

</Layout>

<style>
  header {
    margin-bottom: 2.5rem;
  }

  .tagline {
    color: var(--fg-muted);
    font-size: 1.05rem;
    margin-top: 0.35rem;
  }

  .about {
    margin-bottom: 2.5rem;
    color: var(--fg-muted);
    line-height: 1.7;
  }

  .topic-list h2 {
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-muted);
    margin-bottom: 0.75rem;
  }

  .empty {
    color: var(--fg-subtle);
  }

  .topics {
    display: flex;
    flex-direction: column;
  }

  .topic-link {
    display: flex;
    align-items: center;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--fg);
  }

  .topic-link:first-child {
    padding-top: 0;
  }

  .topic-link:hover {
    text-decoration: none;
  }

  .link-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .chevron {
    flex-shrink: 0;
    margin-left: 1rem;
    font-size: 1.5rem;
    color: var(--fg-subtle);
  }

  .topic-name {
    font-weight: 600;
    font-size: 1.1rem;
  }

  .topic-period {
    font-size: 0.8rem;
    color: var(--fg-subtle);
    margin-top: 0.15rem;
  }
</style>
