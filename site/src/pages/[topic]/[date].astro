---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import Overview from '../../components/Overview.astro';
import StoryCard from '../../components/StoryCard.astro';
import Colophon from '../../components/Colophon.astro';
import Warnings from '../../components/Warnings.astro';
import { TOPIC_META } from '../../lib/topics';
import { fiDate } from '../../lib/date';

export function getStaticPaths() {
  const dataDir = path.resolve('../data/output');

  if (!fs.existsSync(dataDir)) {
    console.warn('Data directory not found:', dataDir);
    return [];
  }

  const files = fs.readdirSync(dataDir).filter(f => f.endsWith('.json'));

  return files.map(file => {
    const data = JSON.parse(fs.readFileSync(path.join(dataDir, file), 'utf-8'));
    const dd = data.display_date || data.period_start;
    return {
      params: { topic: data.topic, date: dd },
      props: { briefing: data },
    };
  });
}

const { briefing } = Astro.props;
const topicUpper = briefing.topic.toUpperCase();
const dateStr = briefing.display_date || briefing.period_start;
const prettyDate = briefing.display_date_fi || fiDate(dateStr);
const digestTopic = briefing.digest_topic || "";
const ogTitle = digestTopic ? `${digestTopic} — Ainikki` : `Ainikki — ${topicUpper} — ${prettyDate}`;
const ogUrl = `${import.meta.env.BASE_URL}/${briefing.topic}/${dateStr}/`;

const topic = briefing.topic;
const meta = TOPIC_META[topic];
const TIETOJA_URL = `${import.meta.env.BASE_URL}/tietoja/`;
const period = briefing.period || "daily";
const pipelinePath = path.resolve(`../data/pipeline/${topic}_${period}_${dateStr}.json`);
const hasPipelineDebug = fs.existsSync(pipelinePath);
---

<Layout title={`${topicUpper} — ${prettyDate}`} description={briefing.overview}
        ogTitle={ogTitle} ogDescription={briefing.overview} ogUrl={ogUrl}>
  <nav class="back">
    <a href="../">← {topicUpper}</a>
  </nav>

  <header>
    <h1>{topicUpper} — {prettyDate}</h1>
    {briefing.digest_topic && <p class="digest-topic">{briefing.digest_topic}</p>}
    <p class="byline">
      Kirjoittanut Ainikki (tekoäly) · klo {new Date(briefing.meta.generated_at).toLocaleTimeString('fi-FI', { hour: 'numeric', minute: '2-digit' })}
      {meta?.telegramUrl && <span> · <a href={meta.telegramUrl} target="_blank" rel="noopener noreferrer">Telegram</a></span>}
      <span> · <a href={TIETOJA_URL}>Lisätietoja Ainikista</a></span>
    </p>
  </header>

  <Overview text={briefing.overview} />

  <hr />

  <section class="stories">
    {briefing.items
      .slice()
      .sort((a: any, b: any) => a.rank - b.rank)
      .map((item: any) => <StoryCard item={item} />)}
  </section>

  <Warnings droppedStories={briefing.dropped_stories} />

  <div class="digest-meta">
    <Colophon
      modelsUsed={briefing.meta.models_used}
      llmStats={briefing.meta.llm_stats}
      lapivalaisuUrl={hasPipelineDebug ? `${import.meta.env.BASE_URL}/läpivalaisu/?topic=${topic}&date=${dateStr}` : undefined}
    />
    <Warnings warnings={briefing.warnings} />
  </div>
</Layout>

<style>
  .back {
    margin-bottom: 2rem;
    font-size: 0.9rem;
  }

  header {
    margin-bottom: 2rem;
  }

  .digest-topic {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--fg);
    margin-top: 0.35rem;
    line-height: 1.4;
  }

  .byline {
    color: var(--fg-subtle);
    font-size: 0.8rem;
    margin-top: 0.35rem;
  }

  .digest-meta {
    margin-top: 0.75rem;
  }

  .stories {
    display: flex;
    flex-direction: column;
  }
</style>
