---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import Overview from '../../components/Overview.astro';
import StoryCard from '../../components/StoryCard.astro';
import Colophon from '../../components/Colophon.astro';
import Warnings from '../../components/Warnings.astro';
import { TOPIC_META } from '../../lib/topics';
import { fiDate } from '../../lib/date';
import { isSiteTopic } from '../../lib/site-data';

export function getStaticPaths() {
  const dataDir = path.resolve('../data/output');

  if (!fs.existsSync(dataDir)) {
    console.warn('Data directory not found:', dataDir);
    return [];
  }

  const files = fs.readdirSync(dataDir).filter(f => f.endsWith('.json'));
  const briefings = files.map(file => {
    const data = JSON.parse(fs.readFileSync(path.join(dataDir, file), 'utf-8'));
    const dd = data.display_date || data.period_start;
    return { ...data, _dd: dd };
  }).filter(briefing => isSiteTopic(briefing.topic));

  // Group by topic, sort descending by display_date
  const byTopic = new Map<string, any[]>();
  for (const b of briefings) {
    const list = byTopic.get(b.topic) || [];
    list.push(b);
    byTopic.set(b.topic, list);
  }

  for (const [, list] of byTopic) {
    list.sort((a, b) => (b.display_date || b.period_start).localeCompare(a.display_date || a.period_start));
  }

  // Assign next/prev within each topic group
  // In descending order: prev = older (index+1), next = newer (index-1)
  for (const [, list] of byTopic) {
    for (let i = 0; i < list.length; i++) {
      list[i]._prev = i + 1 < list.length ? list[i + 1] : null;
      list[i]._next = i - 1 >= 0 ? list[i - 1] : null;
    }
  }

  const result = [];
  for (const [, list] of byTopic) {
    for (const b of list) {
      result.push({
        params: { topic: b.topic, date: b._dd },
        props: { briefing: b },
      });
    }
  }

  return result;
}

const { briefing } = Astro.props;
const topicUpper = briefing.topic.toUpperCase();
const dateStr = briefing.display_date || briefing.period_start;
const prettyDate = briefing.display_date_fi || fiDate(dateStr);
const digestTopic = briefing.digest_topic || "";
const ogTitle = digestTopic ? `${digestTopic} — Ainikki` : `Ainikki — ${topicUpper} — ${prettyDate}`;
const ogUrl = `${import.meta.env.BASE_URL}/${briefing.topic}/${dateStr}/`;

const topic = briefing.topic;
const meta = TOPIC_META[topic];
const TIETOJA_URL = `${import.meta.env.BASE_URL}/tietoja/`;
const period = briefing.period || "daily";
const pipelinePath = path.resolve(`../data/pipeline/${topic}_${period}_${dateStr}.json`);
const hasPipelineDebug = fs.existsSync(pipelinePath);

const audioFilename = `${topic}_${period}_${dateStr}_audio.mp3`;
const audioPath = path.resolve(`../data/output/${audioFilename}`);
const hasAudio = fs.existsSync(audioPath);

function navUrl(b: any): string | null {
  if (!b) return null;
  const dd = b.display_date || b.period_start;
  return `${import.meta.env.BASE_URL}/${b.topic}/${dd}/`;
}

const prevBriefing = briefing._prev || null;
const nextBriefing = briefing._next || null;
---

<Layout title={`${topicUpper} — ${prettyDate}`} description={briefing.overview}
        ogTitle={ogTitle} ogDescription={briefing.overview} ogUrl={ogUrl}>
  <nav class="back">
    <a href="../">{topicUpper}</a>
  </nav>

  <nav class="page-nav page-nav--top">
    <span class="page-nav__prev">{prevBriefing && <a href={navUrl(prevBriefing)}>← Edellinen</a>}</span>
    <span class="page-nav__next">{nextBriefing && <a href={navUrl(nextBriefing)}>Seuraava →</a>}</span>
  </nav>

  <header>
    <h1>{topicUpper} — {prettyDate}</h1>
    {briefing.digest_topic && <p class="digest-topic">{briefing.digest_topic}</p>}
    <p class="byline">
      Kirjoittanut Ainikki (tekoäly) · klo {new Date(briefing.meta.generated_at).toLocaleTimeString('fi-FI', { hour: 'numeric', minute: '2-digit' })}
      {meta?.telegramUrl && <span> · <a href={meta.telegramUrl} target="_blank" rel="noopener noreferrer">Telegram</a></span>}
      <span> · <a href={TIETOJA_URL}>Lisätietoja Ainikista</a></span>
    </p>
  </header>

  {hasAudio && (
    <audio controls preload="metadata" src={`${import.meta.env.BASE_URL}/data/output/${audioFilename}`} class="audio-player" aria-label="Kuunteluvalikko" />
  )}

  <Overview text={briefing.overview} />

  <hr />

  <section class="stories">
    {briefing.items
      .slice()
      .sort((a: any, b: any) => a.rank - b.rank)
      .map((item: any) => <StoryCard item={item} />)}
  </section>

  <Warnings droppedStories={briefing.dropped_stories} />

  <div class="digest-meta">
    <Colophon
      modelsUsed={briefing.meta.models_used}
      llmStats={briefing.meta.llm_stats}
      lapivalaisuUrl={hasPipelineDebug ? `${import.meta.env.BASE_URL}/läpivalaisu/?topic=${topic}&date=${dateStr}` : undefined}
    />
    <Warnings warnings={briefing.warnings} />
  </div>

  <nav class="page-nav page-nav--bottom">
    <span class="page-nav__prev">{prevBriefing && <a href={navUrl(prevBriefing)}>← Edellinen</a>}</span>
    <span class="page-nav__next">{nextBriefing && <a href={navUrl(nextBriefing)}>Seuraava →</a>}</span>
  </nav>
</Layout>

<style>
  .back {
    margin-bottom: 2rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }

  .back a {
    color: var(--fg-muted);
  }

  .page-nav {
    display: flex;
    font-size: 0.85rem;
  }

  .page-nav--top {
    margin-bottom: 2rem;
  }

  .page-nav__prev {
    flex: 1;
    text-align: left;
  }

  .page-nav__next {
    flex: 1;
    text-align: right;
  }

  .page-nav--bottom {
    margin-top: 2.5rem;
  }

  header {
    margin-bottom: 2rem;
  }

  .digest-topic {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--fg);
    margin-top: 0.35rem;
    line-height: 1.4;
  }

  .byline {
    color: var(--fg-subtle);
    font-size: 0.8rem;
    margin-top: 0.35rem;
  }

  .digest-meta {
    margin-top: 0.75rem;
  }

  .stories {
    display: flex;
    flex-direction: column;
  }

  .audio-player {
    width: 100%;
    max-width: 620px;
    height: 3.5rem;
    margin: 0.75rem auto;
    display: block;
    border-radius: 0.75rem;
    filter: grayscale(1) contrast(90%) opacity(0.82);
  }
</style>
