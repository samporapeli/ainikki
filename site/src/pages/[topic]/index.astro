---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  const dataDir = path.resolve('../data/output');

  if (!fs.existsSync(dataDir)) {
    return [];
  }

  const files = fs.readdirSync(dataDir).filter(f => f.endsWith('.json'));
  const byTopic = new Map<string, any[]>();

  for (const file of files) {
    const data = JSON.parse(fs.readFileSync(path.join(dataDir, file), 'utf-8'));
    if (!byTopic.has(data.topic)) byTopic.set(data.topic, []);
    byTopic.get(data.topic)!.push(data);
  }

  return [...byTopic.entries()].map(([topic, briefings]) => {
    briefings.sort((a: any, b: any) =>
      (b.display_date || b.period_start).localeCompare(a.display_date || a.period_start));
    return {
      params: { topic },
      props: { topic, briefings },
    };
  });
}

const topicInfo: Record<string, { name: string; period: string; telegram: string; telegramUrl: string }> = {
  ai: { name: 'Tekoäly', period: 'päivittäinen', telegram: 'Päivän AI-uutiset — Ainikki', telegramUrl: 'https://t.me/ainikki_ai' },
  teknologia: { name: 'Teknologia', period: 'viikoittainen', telegram: 'Viikon teknologiauutiset — Ainikki', telegramUrl: 'https://t.me/ainikki_teknologia' },
};

const TIETOJA_URL = `${import.meta.env.BASE_URL}/tietoja/`;

const { topic, briefings } = Astro.props;
const info = topicInfo[topic] ?? { name: topic.toUpperCase(), period: '', telegram: '', telegramUrl: '' };

const WEEKDAYS = ['sunnuntai', 'maanantai', 'tiistai', 'keskiviikko', 'torstai', 'perjantai', 'lauantai'];

function fiDate(iso: string): string {
  const [y, m, d] = iso.split('-').map(Number);
  const wd = WEEKDAYS[new Date(y, m - 1, d).getDay()];
  return `${wd} ${d}.${m}.${y}`;
}
---

<Layout title={`${info.name} — Ainikki`}>
  <nav class="back">
    <a href="../">← Ainikki</a>
  </nav>

  <header>
    <h1>{info.name}</h1>
    <p class="meta">
      Kirjoittanut Ainikki (tekoäly) · {info.period} kooste
      {info.telegram && <span> · <a href={info.telegramUrl} target="_blank" rel="noopener noreferrer">Telegram</a></span>}
      <span> · <a href={TIETOJA_URL}>Lisätietoja Ainikista</a></span>
    </p>
  </header>

  <section class="list">
    {briefings.map((b: any) => {
      const dd = b.display_date || b.period_start;
      const pretty = b.display_date_fi || fiDate(dd);
      return (
        <a href={`${dd}/`} class="entry">
          <span class="date">{pretty}</span>
          <p class="overview">{b.overview}</p>
        </a>
      );
    })}
  </section>
</Layout>

<style>
  .back {
    margin-bottom: 2rem;
    font-size: 0.9rem;
  }

  header {
    margin-bottom: 2rem;
  }

  .meta {
    color: var(--fg-muted);
    font-size: 0.9rem;
    margin-top: 0.25rem;
  }

  .meta a {
    color: var(--link);
  }

  .list {
    display: flex;
    flex-direction: column;
  }

  .entry {
    display: block;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--fg);
  }

  .entry:first-child {
    padding-top: 0;
  }

  .entry:hover {
    text-decoration: none;
  }

  .date {
    display: block;
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 0.35rem;
  }

  .overview {
    color: var(--fg-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }
</style>
