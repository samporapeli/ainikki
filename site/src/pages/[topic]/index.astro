---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  const dataDir = path.resolve('../data/output');

  if (!fs.existsSync(dataDir)) {
    return [];
  }

  const files = fs.readdirSync(dataDir).filter(f => f.endsWith('.json'));
  const byTopic = new Map<string, any[]>();

  for (const file of files) {
    const data = JSON.parse(fs.readFileSync(path.join(dataDir, file), 'utf-8'));
    if (!byTopic.has(data.topic)) byTopic.set(data.topic, []);
    byTopic.get(data.topic)!.push(data);
  }

  return [...byTopic.entries()].map(([topic, briefings]) => {
    briefings.sort((a: any, b: any) =>
      (b.display_date || b.period_start).localeCompare(a.display_date || a.period_start));
    return {
      params: { topic },
      props: { topic, briefings },
    };
  });
}

const { topic, briefings } = Astro.props;
const topicUpper = topic.toUpperCase();

const WEEKDAYS = ['sunnuntai', 'maanantai', 'tiistai', 'keskiviikko', 'torstai', 'perjantai', 'lauantai'];

function fiDate(iso: string): string {
  const [y, m, d] = iso.split('-').map(Number);
  const wd = WEEKDAYS[new Date(y, m - 1, d).getDay()];
  return `${wd} ${d}.${m}.${y}`;
}
---

<Layout title={`${topicUpper} — Ainikki`}>
  <nav class="back">
    <a href="../">← Ainikki</a>
  </nav>

  <header>
    <h1>{topicUpper}</h1>
  </header>

  <section class="list">
    {briefings.map((b: any) => {
      const dd = b.display_date || b.period_start;
      return (
        <a href={`${dd}/`} class="entry">
          <span class="date">{fiDate(dd)}</span>
          <p class="overview">{b.overview}</p>
        </a>
      );
    })}
  </section>
</Layout>

<style>
  .back {
    margin-bottom: 2rem;
    font-size: 0.9rem;
  }

  header {
    margin-bottom: 2rem;
  }

  .list {
    display: flex;
    flex-direction: column;
  }

  .entry {
    display: block;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--fg);
  }

  .entry:first-child {
    padding-top: 0;
  }

  .entry:hover {
    text-decoration: none;
  }

  .date {
    display: block;
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 0.35rem;
  }

  .overview {
    color: var(--fg-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }
</style>
